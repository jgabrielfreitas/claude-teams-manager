# A single root ignore file is enough: these patterns match at any depth, so
# they already cover every package under packages/ and apps/.

# Dependencies
node_modules/
.pnpm-store/

# Build output and caches
dist/
build/
coverage/
*.tsbuildinfo
.vite/
*.tgz

# Local application data — the database, run history, the instance lock — is
# per-machine state and can contain private workspace content, so it stays out.
# The exception is `teams/`: that folder is the YAML mirror of your teams,
# written on every change precisely so it CAN be reviewed and committed.
# (Ignoring the contents rather than the directory is what makes the negation
# work: git cannot re-include a path whose parent directory is excluded.)
.claude-team/*
!.claude-team/teams/
instance.lock
*.db
*.db-wal
*.db-shm

# Secrets
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Editors
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
