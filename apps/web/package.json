{
  "name": "@claude-team/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,client -c cyan,magenta \"pnpm dev:server\" \"pnpm dev:client\"",
    "dev:server": "tsx watch src/server/index.ts",
    "dev:client": "vite",
    "build": "tsc -b && vite build",
    "start": "node --import tsx dist/server/index.js",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@claude-team/core": "workspace:*",
    "@claude-team/domain": "workspace:*",
    "@claude-team/protocol": "workspace:*",
    "@claude-team/ui-shared": "workspace:*",
    "@hono/node-server": "^1.13.7",
    "hono": "^4.6.14",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1"
  },
  "devDependencies": {
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "vite": "^6.0.7"
  }
}
